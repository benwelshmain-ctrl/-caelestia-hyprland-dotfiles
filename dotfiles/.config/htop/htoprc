# HTOP Color Configuration Template
# This template generates a custom htoprc configuration with themed colors
# Colors are defined using terminal color codes (0-255) or RGB hex values

# htoprc configuration with custom colors
fields=0 48 17 18 38 39 40 2 46 47 49 1
sort_key=46
sort_direction=-1
tree_sort_key=0
tree_sort_direction=1
hide_kernel_threads=1
hide_userland_threads=0
shadow_other_users=0
show_thread_names=0
show_program_path=1
highlight_base_name=0
highlight_deleted_exe=1
highlight_megabytes=1
highlight_threads=1
highlight_changes=0
highlight_changes_delay_secs=5
find_comm_in_cmdline=1
strip_exe_from_cmdline=1
show_merged_command=0
tree_view=0
tree_view_always_by_pid=0
all_branches_collapsed=0
header_margin=1
detailed_cpu_time=0
cpu_count_from_one=0
show_cpu_usage=1
show_cpu_frequency=0
show_cpu_temperature=0
degree_fahrenheit=0
update_process_names=0
account_guest_in_cpu_meter=0
color_scheme=6

# Custom color definitions using template variables
# Main interface colors
color_background=#0f0e08
color_text=#ebe5d2
color_highlight=#d0c88b
color_selected=#1b1a10

# CPU meter colors (gradient)
color_cpu_low=#e2e683
color_cpu_med=#fdf2bd
color_cpu_high=#deac3b

# Memory meter colors
color_mem_used=#75cf9d
color_mem_buffers=#d8e799
color_mem_cache=#b1d280
color_mem_available=#e2e683

# Process list colors
color_process_normal=#ebe5d2
color_process_running=#e2e683
color_process_sleeping=#797666
color_process_zombie=#deac3b
color_process_stopped=#fdf2bd

# Header and border colors
color_header=#afab99
color_border=#797666
color_separator=#4b483a

# Function key colors
color_function_key=#ffd6a4
color_function_desc=#ebe5d2

# Tree view colors
color_tree_line=#797666
color_tree_collapsed=#d0c88b
color_tree_expanded=#cdc7a3

# Load average colors
color_load_low=#e2e683
color_load_med=#fdf2bd
color_load_high=#deac3b

# Priority colors
color_priority_high=#deac3b
color_priority_normal=#ebe5d2
color_priority_low=#797666

# Swap meter colors
color_swap_used=#ddba70
