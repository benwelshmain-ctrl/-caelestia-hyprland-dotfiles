{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "~/Pictures/Logo/ben.png",
    "width": 30,
    "height": 15,
    "padding": { "top": 0, "left": 2, "right": 2 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    "break",
    { "type": "custom", "format": "Welcome back, user", "outputColor": "1;38;2;139;80;214" },
    { "type": "custom", "format": "──────────────────────────────", "outputColor": "38;2;74;40;120" },
    { "type": "os",     "key": "\uf17c  OS",    "keyColor": "38;2;106;44;170", "format": "{3}" },
    { "type": "wm",     "key": "\uf2d0  WM",    "keyColor": "38;2;130;62;200" },
    { "type": "shell",  "key": "\uf120  Shell", "keyColor": "38;2;95;85;215" },
    { "type": "uptime", "key": "\uf017  Uptime","keyColor": "38;2;70;120;225" },
    { "type": "cpu",    "key": "\uf2db  CPU",   "keyColor": "38;2;55;165;225" },
    { "type": "gpu",    "key": "\uf26c  GPU",   "keyColor": "38;2;50;190;185", "format": "RTX 3060" },
    { "type": "memory", "key": "\uf1c0  RAM",   "keyColor": "38;2;205;85;185", "format": "{1} / {2} ({3})" },
    { "type": "disk",   "key": "\uf0a0  Disk",  "keyColor": "38;2;235;105;145", "folders": "/", "format": "{1} / {2} ({3})" },
    { "type": "custom", "format": "──────────────────────────────", "outputColor": "38;2;74;40;120" },
    { "type": "colors", "key": "", "symbol": "circle", "paddingLeft": 0 }
  ]
}
