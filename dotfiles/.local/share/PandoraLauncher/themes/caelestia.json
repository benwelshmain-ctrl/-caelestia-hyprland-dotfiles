{
  "$schema": "https://github.com/longbridge/gpui-component/raw/refs/heads/main/.theme-schema.json",
  "name": "Caelestia",
  "author": "Unrectified",
  "url": "https://github.com/caelestia-dots/cli",
  "themes": [
    {
      "name": "Caelestia",
      "mode": "dark",
      "colors": {
        "accent.background": "#202020",
        "accent.foreground": "#e5e5e5",
        "background": "#0e0e0e",
        "border": "#484848",
        "danger.background": "#d98883",
        "foreground": "#e5e5e5",
        "input.border": "#767676",
        "link.active.foreground": "#c6c6c6",
        "link.foreground": "#c6c6c6",
        "link.hover.foreground": "#e2e2e2",
        "list.active.background": "#3b3b3b",
        "list.active.border": "#9d9d9d",
        "list.even.background": "#000000",
        "muted.background": "#262626",
        "muted.foreground": "#ababab",
        "panel.background": "#1a1a1a",
        "popover.background": "#202020",
        "popover.foreground": "#e5e5e5",
        "primary.active.background": "#d4d4d4",
        "primary.background": "#c6c6c6",
        "primary.foreground": "#404040",
        "primary.hover.background": "#e2e2e2",
        "scrollbar.background": "#0e0e0e",
        "scrollbar.thumb.background": "#767676",
        "secondary.background": "#3b3b3b",
        "secondary.active.background": "#d4d4d4",
        "secondary.foreground": "#202020",
        "secondary.hover.background": "#e3e3e3",
        "tab.active.background": "#0e0e0e",
        "tab.active.foreground": "#e5e5e5",
        "tab.background": "#000000",
        "tab.foreground": "#ababab",
        "tab_bar.background": "#0e0e0e",
        "table.background": "#1a1a1a",
        "table.head.foreground": "#ababab",
        "table.row.border": "#484848",
        "title_bar.background": "#0e0e0e",
        "ring": "#c6c6c6",
        "base.red": "#9db5e2",
        "base.red.light": "#bed4bc",
        "base.green": "#b5e9e9",
        "base.green.light": "#c3e6ea",
        "base.blue": "#8fc5d7",
        "base.blue.light": "#bbe2ea",
        "base.cyan": "#c3e6ea",
        "base.cyan.light": "#bbe2ea",
        "base.magenta": "#96c7e0",
        "base.magenta.light": "#d2deea",
        "base.yellow": "#ecf3f0",
        "base.yellow.light": "#bed4bc"
      },
      "highlight": {
        "editor.foreground": "#e5e5e5",
        "editor.background": "#0e0e0e",
        "editor.active_line.background": "#141414",
        "editor.line_number": "#ababab",
        "editor.active_line_number": "#e5e5e5",
        "editor.invisible": "#484848",
        "conflict": "#9db5e2",
        "created": "#b5e9e9",
        "deleted": "#9db5e2",
        "error": "#d98883",
        "hidden": "#767676",
        "hint": "#B5CCBA",
        "ignored": "#767676",
        "info": "#8fc5d7",
        "modified": "#ecf3f0",
        "predictive": "#585858",
        "renamed": "#b5e9e9",
        "success": "#B5CCBA",
        "unreachable": "#484848",
        "warning": "#ecf3f0",
        "syntax": {
          "attribute": {
            "color": "#ecf3f0"
          },
          "boolean": {
            "color": "#b5e9e9"
          },
          "comment": {
            "color": "#767676",
            "font_style": "italic"
          },
          "comment.doc": {
            "color": "#767676",
            "font_style": "italic"
          },
          "constant": {
            "color": "#9db5e2"
          },
          "constructor": {
            "color": "#ecf3f0"
          },
          "embedded": {
            "color": "#e5e5e5"
          },
          "function": {
            "color": "#b5e9e9"
          },
          "keyword": {
            "color": "#96c7e0"
          },
          "link_text": {
            "color": "#bbe2ea",
            "font_style": "normal"
          },
          "link_uri": {
            "color": "#588f9f",
            "font_style": "italic"
          },
          "number": {
            "color": "#9db5e2"
          },
          "string": {
            "color": "#b5e9e9"
          },
          "string.escape": {
            "color": "#b5e9e9"
          },
          "string.regex": {
            "color": "#b5e9e9"
          },
          "string.special": {
            "color": "#ecf3f0"
          },
          "string.special.symbol": {
            "color": "#ecf3f0"
          },
          "tag": {
            "color": "#ecf3f0"
          },
          "text.literal": {
            "color": "#9db5e2"
          },
          "title": {
            "color": "#bbe2ea",
            "font_weight": 600
          },
          "type": {
            "color": "#ecf3f0"
          },
          "property": {
            "color": "#e5e5e5"
          },
          "variable.special": {
            "color": "#9db5e2"
          }
        }
      }
    }
  ]
}
