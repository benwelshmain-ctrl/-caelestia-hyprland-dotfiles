#!/usr/bin/env bash

image=${1-}
transition=${2:-grow}
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia"
log_file="$state_dir/awww-wallpaper.log"

case "$transition" in
    wave|grow) ;;
    *) transition=grow ;;
esac

mkdir -p "$state_dir"

log() {
    printf '%s %s\n' "$(date --iso-8601=seconds)" "$*" >> "$log_file"
}

log "Wallpaper request: $image (transition: $transition)"

if [[ ! -f "$image" ]]; then
    log "Skipped: image path does not exist"
    exit 1
fi

if ! command -v awww >/dev/null 2>&1 || ! command -v awww-daemon >/dev/null 2>&1; then
    log "Skipped: Awww executable is missing"
    exit 1
fi

if ! awww query >/dev/null 2>&1; then
    log "Daemon not responding; starting it on the bottom layer"
    awww-daemon --layer bottom >/dev/null 2>&1 </dev/null &

    for _ in {1..50}; do
        if awww query >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done
fi

if ! awww query >/dev/null 2>>"$log_file"; then
    log "Failed: Awww daemon is still unavailable"
    exit 1
fi

mapfile -t plans < <("$HOME/.local/bin/caelestia-wallpaper-fit.py" "$image" 2>>"$log_file")
if (( ${#plans[@]} == 0 )); then
    log "Failed: could not prepare the wallpaper for Awww"
    exit 1
fi

result=0
for plan in "${plans[@]}"; do
    IFS=$'\t' read -r output fitted <<< "$plan"
    args=(img --resize fit --filter Lanczos3 --transition-type "$transition" --transition-duration 1 --transition-fps 60)
    if [[ "$transition" == "grow" ]]; then
        args+=(--transition-pos center)
    fi
    if [[ "$output" != "*" ]]; then
        args+=(--outputs "$output")
    fi
    args+=("$fitted")

    awww "${args[@]}" >>"$log_file" 2>&1
    command_result=$?
    if [[ $command_result -ne 0 ]]; then
        result=$command_result
    fi
done

if [[ $result -eq 0 ]]; then
    log "Transition request accepted"
else
    log "Transition request failed with status $result"
fi

exit "$result"
